{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      { "Name": "Console" }
    ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Default": ""
  },

  "Database": {
    "ApplyMigrationsOnStartup": false,
    "ContainerHost": "yalla-postgres"
  },

  "Jwt": {
    "Issuer": "Yalla.Api",
    "Audience": "Yalla.Api.Client",
    "Key": "",
    "AccessTokenMinutes": 43200
  },

  "MinIo": {
    "Endpoint": "",
    "ContainerEndpoint": "",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "",
    "UseSsl": false
  },

  "SmsVerification": {
    "RegistrationEnabled": true,
    "AllowRegistrationBypass": false,
    "CodeLength": 4,
    "CodeTtlMinutes": 10,
    "ResendCooldownSeconds": 60,
    "MaxVerificationAttempts": 5,
    "MaxResendCount": 5,
    "RequestRateLimitPerMinute": 20,
    "VerifyRateLimitPerMinute": 60,
    "ResendRateLimitPerMinute": 20,
    "CleanupIntervalMinutes": 15,
    "ExpiredSessionRetentionMinutes": 120,
    "CompletedSessionRetentionHours": 24,
    "MessageTemplate": "Код подтверждения Yalla Farm: {code}",
    "WebOtpOrigin": "",
    "FixedCodeForTests": ""
  },

  "DushanbeCityPayment": {
    "BaseUrl": "",
    "AlifUrlTemplate": "https://alifmobi.page.link/toMobi?account=%2B992926406699&summa={amount}&_imcp=1",
    "EskhataUrlTemplate": "eskhata://service/96e8b785-b1b9-11e8-904b-b06ebfbfa715/992927964433/{amount}/DA00126FM",
    "ProviderName": "DushanbeCityManualPhone",
    "Currency": "TJS",
    "CreateOrderOnlyAfterAdminPaymentConfirmation": true,
    "PendingConfirmationTimeoutMinutes": 3,
    "CleanupIntervalSeconds": 30
  },

  "OsonSms": {
    "ApiBaseUrl": "https://api.osonsms.com",
    "AuthMode": "Hash",
    "Login": "",
    "Token": "",
    "Sender": "Yalla",
    "PassSaltHash": "",
    "Delimiter": ";",
    "T": "23",
    "IsConfidential": true,
    "UseStub": true,
    "TimeoutSeconds": 20,
    "MaxRetryAttempts": 2,
    "RetryBackoffSeconds": 2
  },

  "SmsOutbox": {
    "Enabled": true,
    "BatchSize": 50,
    "PollIntervalSeconds": 15,
    "MaxAttempts": 5,
    "RetryBackoffSeconds": 30,
    "RetentionDays": 7
  },

  "TelegramOutbox": {
    "Enabled": true,
    "BatchSize": 50,
    "PollIntervalSeconds": 15,
    "MaxAttempts": 5,
    "RetryBackoffSeconds": 30,
    "RetentionDays": 7
  },

  "SmsTemplates": {
    "Provider": "OsonSms",
    "PaymentConfirmed": "Оплата подтверждена. Заказ {orderId} оформлен. Сумма: {amount} {currency}.",
    "OrderStatus": {
      "New": "Заказ {orderId} создан и ожидает подтверждения.",
      "UnderReview": "Заказ {orderId} принят и передан в обработку. Сумма: {amount} {currency}.",
      "Preparing": "Заказ {orderId} готовится аптекой. Сумма: {amount} {currency}.",
      "Ready": "Заказ {orderId} собран и готов к выдаче/доставке. Сумма: {amount} {currency}.",
      "OnTheWay": "Заказ {orderId} передан курьеру и в пути. Сумма: {amount} {currency}.",
      "DriverArrived": "Курьер прибыл по адресу. Заказ {orderId}. Сумма: {amount} {currency}.",
      "Delivered": "Заказ {orderId} успешно доставлен. Сумма: {amount} {currency}.",
      "PickedUp": "Заказ {orderId} получен в аптеке. Сумма: {amount} {currency}.",
      "Cancelled": "Заказ {orderId} отменён. Сумма: {amount} {currency}.",
      "Returned": "Заказ {orderId} переведён в статус возврата. Сумма: {amount} {currency}."
    },
    "JuraDelivery": {
      "4": "Курьер на месте. Код для получения: {receiptCode}",
      "7": "Курьер везёт ваш заказ. Код для получения: {receiptCode}",
      "9": "Заказ доставлен. Спасибо за покупку!",
      "10": "Доставка заказа {orderId} отменена. Средства будут возвращены."
    }
  },

  "OneCImport": {
    "Enabled": false,
    "ExchangeDirectory": "/data/1c-exchange",
    "PollIntervalSeconds": 60,
    "StableFileSeconds": 30,
    "DefaultSourceToken": "",
    "DefaultSourceName": "1C",
    "DefaultPharmacyId": "00000000-0000-0000-0000-000000000000"
  },

  "Jura": {
    "BaseUrl": "https://api-3taxi.gram.tj",
    "Login": "",
    "Password": "",
    "DivisionId": 6,
    "DefaultTariffId": 37,
    "DefaultPayTypeId": 29185
  },

  "Elasticsearch": {
    "Url": "",
    "MedicineIndex": "medicines"
  },

  "Telegram": {
    "BotToken": "",
    "BotUsername": "",
    "WebhookPublicBaseUrl": "",
    "WebhookSecretToken": "",
    "AuthSessionTtlSeconds": 300,
    "AutoRegisterWebhookOnStart": false
  },

  "TelegramStaffNotifications": {
    "Enabled": true,
    "BotToken": "",
    "BotUsername": "",
    "PublicBaseUrl": "",
    "WebhookSecretToken": "",
    "AutoRegisterWebhookOnStart": false,
    "BatchSize": 50,
    "PollIntervalSeconds": 15,
    "MaxAttempts": 5,
    "RetryBackoffSeconds": 30,
    "RetentionDays": 7,
    "CatchUpMaxOrderAgeHours": 48,
    "CatchUpMaxLookupAgeHours": 48
  },

  "TelegramSuperAdminNotifications": {
    "Enabled": true,
    "BotToken": "",
    "BotUsername": "yallapharm_superadmin_notify_bot",
    "PublicBaseUrl": "",
    "WebhookSecretToken": "",
    "AutoRegisterWebhookOnStart": false,
    "BatchSize": 50,
    "PollIntervalSeconds": 15,
    "MaxAttempts": 5,
    "RetryBackoffSeconds": 30,
    "RetentionDays": 7,
    "CatchUpMaxOrderAgeHours": 48,
    "CatchUpMaxPrescriptionAgeHours": 48
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },

  "Compliance": {
    "PrivacyPolicyCurrentVersion": "1.0-2026-05-12",
    "PrivacyPolicyEffectiveDate": "2026-05-12"
  },

  "Prescription": {
    "PaymentTimeoutHours": 24,
    "PaymentTimeoutCheckIntervalMinutes": 10
  }
}
